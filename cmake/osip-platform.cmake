include(CheckIncludeFile)
include(CheckSymbolExists)
include(CheckStructHasMember)
include(CMakePushCheckState)
cmake_push_check_state(RESET)

foreach(osip_header IN ITEMS
        ctype.h string.h strings.h stdarg.h sys/types.h sys/stat.h time.h
        sys/time.h fcntl.h unistd.h sys/unistd.h sys/select.h syslog.h
        semaphore.h sys/sem.h)
    string(TOUPPER "${osip_header}" osip_header_variable)
    string(REGEX REPLACE "[^A-Z0-9]" "_" osip_header_variable "${osip_header_variable}")
    check_include_file("${osip_header}" "HAVE_${osip_header_variable}")
endforeach()
check_symbol_exists(localtime "time.h" HAVE_LOCALTIME)
check_symbol_exists(strtol "stdlib.h" HAVE_STRTOL)
check_symbol_exists(lrand48 "stdlib.h" HAVE_LRAND48)
if(WIN32)
    check_struct_has_member("struct timeval" tv_sec "winsock2.h" HAVE_STRUCT_TIMEVAL)
else()
    check_struct_has_member("struct timeval" tv_sec "sys/time.h" HAVE_STRUCT_TIMEVAL)
endif()

set(OSIP_NEEDS_THREADS OFF)
if(NOT OSIP_MONOTHREAD AND NOT WIN32)
    set(THREADS_PREFER_PTHREAD_FLAG ON)
    find_package(Threads REQUIRED)
    if(NOT CMAKE_USE_PTHREADS_INIT)
        message(FATAL_ERROR "oSIP needs POSIX threads on this platform; use OSIP_MONOTHREAD=ON to disable them")
    endif()
    set(HAVE_PTHREAD 1)
    set(OSIP_NEEDS_THREADS ON)
    if(NOT HAVE_SEMAPHORE_H AND NOT HAVE_SYS_SEM_H AND NOT APPLE)
        message(FATAL_ERROR "oSIP needs POSIX or System V semaphores when OSIP_MONOTHREAD=OFF")
    endif()
endif()

if(NOT WIN32)
    check_symbol_exists(clock_gettime "time.h" OSIP_HAVE_CLOCK_GETTIME)
    if(NOT OSIP_HAVE_CLOCK_GETTIME)
        include(CheckLibraryExists)
        check_library_exists(rt clock_gettime "" OSIP_HAVE_RT_CLOCK_GETTIME)
        if(OSIP_HAVE_RT_CLOCK_GETTIME)
            set(OSIP_CLOCK_LIBRARY rt)
            set(CMAKE_REQUIRED_LIBRARIES rt)
        endif()
    endif()
    if(OSIP_HAVE_CLOCK_GETTIME OR OSIP_HAVE_RT_CLOCK_GETTIME)
        check_symbol_exists(CLOCK_MONOTONIC "time.h" HAVE_CLOCK_GETTIME_MONOTONIC)
    endif()
    unset(CMAKE_REQUIRED_LIBRARIES)
endif()
cmake_pop_check_state()
configure_file("${CMAKE_CURRENT_LIST_DIR}/osip-config.h.in"
               "${CMAKE_CURRENT_BINARY_DIR}/generated/osip-config.h")
